# Stripe Hosted Checkout is created server-side, so no publishable key is needed.
# Add the matching test or live secret only in the hosting environment.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://zameett.com

# Customer accounts - Supabase Auth (Google + email/password)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
HOSTINGER_MAIL_API_TOKEN=

# Private owner dashboard (server-only)
ADMIN_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=

# JSON array of private client-project records. Keep this server-only and never commit real client data.
CLIENT_PROJECTS_JSON=

# Automatic Google Reviews (server-only; Places API New)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Installable app push notifications (generate as one matching VAPID key pair)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@zameett.com

# Optional dedicated HMAC secret for signed free-order cookies (Stripe secret is the fallback)
FREE_ORDER_COOKIE_SECRET=

# Add only the genuine token supplied by Google Search Console
GOOGLE_SITE_VERIFICATION=
